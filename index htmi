<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Takrim Final - Pet + PDF + Excel + Dynamic Class + Lock</title>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
*{box-sizing:border-box;font-family:'Hind Siliguri',sans-serif;margin:0}
body{background:#0a2e1f;padding:10px}
.card{max-width:460px;margin:auto;background:#fff;border-radius:28px;padding:16px}
.top{background:#0f3a2a;color:#fff;border-radius:16px;padding:12px;display:flex;justify-content:space-between;font-weight:700;font-size:14px}
.add{margin-top:12px;border:3px dashed #16a34a;border-radius:16px;padding:14px;text-align:center;font-weight:700;font-size:18px;cursor:pointer}
.row{display:flex;gap:10px;margin-top:12px}
.box{flex:1;border-radius:16px;padding:12px;text-align:center;font-weight:700;color:#fff;font-size:14px}
.yellow{background:#ffcc00;color:#000}.green{background:#16a34a}.red{background:#ef4444}
.purple{width:100%;margin-top:12px;background:#7c3aed;color:#fff;border:none;border-radius:14px;padding:13px;font-weight:700;font-size:16px}
.mBox{border:2.5px solid #8b5cf6;border-radius:22px;padding:12px;margin-top:14px;background:#fff}
table{width:100%;border-collapse:collapse}
th{font-size:13px;padding:7px 3px;text-align:center;background:#f8f6ff}
td{padding:6px 3px;text-align:center;font-size:13px;font-weight:600;border-bottom:1px solid #eee}
.inp{width:62px;padding:9px 0;background:#f0eef5;border:none;border-radius:14px;text-align:center;font-weight:700;font-size:13px}
.inp:disabled{opacity:1;color:#000}
.inp:not(:disabled){background:#fff;border:1.5px solid #8b5cf6}
.btns{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}
.btns button{padding:11px;border:none;border-radius:12px;font-weight:700;font-size:13px;color:#fff;cursor:pointer}
.save{background:#16a34a}.edit{background:#6b7280}.edit.active{background:#7c3aed}
.pdf{background:#1e293b}.excel{background:#0f7a3a}
</style>
</head>
<body>
<div class="card">
<!-- পেট -->
<div class="top"><span>শ্রেণী: <b id="cls">—</b></span><span>শাখা: <b id="sec">—</b></span><span id="subTop">বিষয়: 3</span></div>
<div class="add" onclick="addStu()">+ শিক্ষার্থী যোগ করুন</div>
<div class="row"><div class="box yellow">📋 সবাই<br><span id="cAll">2</span></div><div class="box green">✅ উপস্থিত<br><span id="cPre">2</span></div><div class="box red">❌ অনুপস্থিত<br><span id="cAbs">0</span></div></div>
<button class="purple">🏆 ফলাফল দেখুন</button>

<div class="mBox" id="rCard">
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><b style="color:#7c3aed">📋 ফলাফল সিট</b><button onclick="renameSub()" style="background:#7c3aed;color:#fff;border:none;border-radius:10px;padding:6px 10px;font-size:11px">নাম বদলান</button></div>
<table><thead><tr id="hRow"></tr></thead><tbody id="bRow"></tbody></table>
<div class="btns">
<button class="save" onclick="saveData()">💾 সেভ</button>
<button class="edit" id="eBtn" onclick="toggleEdit()">✏️ এডিট</button>
<button class="pdf" onclick="downloadPDF()">📄 PDF</button>
<button class="excel" onclick="downloadExcel()">📊 Excel</button>
</div>
</div>
</div>

<script>
let isEdit=false;
let subs=JSON.parse(localStorage.getItem('s_final2')||'["বাংলা","বিষয় 2","বিষয় 3"]');
let full=JSON.parse(localStorage.getItem('f_final2')||'[100,100,100]');
let studs=JSON.parse(localStorage.getItem('st_final2')||'[{"name":"কালাম","roll":"202","m":[70,0,0]},{"name":"কমল","roll":"203","m":[82,0,0]}]');

function getClass(){
 let u=new URLSearchParams(location.search);
 return {
  cls: u.get('class')||localStorage.getItem('takrim_class')||localStorage.getItem('selectedClass')||localStorage.getItem('class')||'৭ম',
  sec: u.get('section')||localStorage.getItem('takrim_section')||localStorage.getItem('selectedSection')||localStorage.getItem('section')||'ক'
 };
}
let fp=getClass();
document.getElementById('cls').innerText=fp.cls;
document.getElementById('sec').innerText=fp.sec;

function render(){
 document.getElementById('subTop').innerText='বিষয়: '+subs.length;
 document.getElementById('hRow').innerHTML=`<th>ক্রম</th><th>নাম</th><th>রোল</th>`+subs.map(s=>`<th>${s}</th>`).join('')+`<th>মো</th>`;
 let html=`<tr><td></td><td><b>পূর্ণমান</b></td><td></td>`+full.map((v,i)=>`<td><input class="inp" type="number" value="${v}" ${!isEdit?'disabled':''} oninput="full[${i}]=parseInt(this.value)||0;render()"></td>`).join('')+`<td>${full.reduce((a,b)=>a+b,0)}</td></tr>`;
 studs.forEach((st,i)=>{
  html+=`<tr><td>${i+1}</td><td>${st.name}</td><td>${st.roll}</td>`+st.m.map((mm,j)=>`<td><input class="inp" type="number" value="${mm}" ${!isEdit?'disabled':''} oninput="studs[${i}].m[${j}]=parseInt(this.value)||0;document.getElementById('t${i}').innerText=studs[${i}].m.reduce((a,b)=>a+b,0)"></td>`).join('')+`<td id="t${i}">${st.m.reduce((a,b)=>a+b,0)}</td></tr>`;
 });
 document.getElementById('bRow').innerHTML=html;
 document.getElementById('cAll').innerText=studs.length;
}
function toggleEdit(){isEdit=!isEdit;let b=document.getElementById('eBtn');b.innerText=isEdit?'🔒 লক':'✏️ এডিট';b.classList.toggle('active',isEdit);render();}
function saveData(){localStorage.setItem('s_final2',JSON.stringify(subs));localStorage.setItem('f_final2',JSON.stringify(full));localStorage.setItem('st_final2',JSON.stringify(studs));isEdit=false;document.getElementById('eBtn').innerText='✏️ এডিট';document.getElementById('eBtn').classList.remove('active');render();alert('সেভ হয়েছে - লক');}
function addStu(){let n=prompt('নাম:'),r=prompt('রোল:');if(n&&r){studs.push({name:n,roll:r,m:Array(subs.length).fill(0)});render();}}
function renameSub(){let v=prompt('বিষয় নাম কমা দিয়ে:',subs.join(','));if(v){subs=v.split(',').map(s=>s.trim());render();}}
function downloadPDF(){const {jsPDF}=window.jspdf;let doc=new jsPDF();doc.text(`Result - Class ${fp.cls} Sec ${fp.sec}`,10,10);let head=[['ক্রম','নাম','রোল',...subs,'মোট']];let body=[['','পূর্ণমান','',...full,full.reduce((a,b)=>a+b,0)]];studs.forEach((st,i)=>{body.push([i+1,st.name,st.roll,...st.m,st.m.reduce((a,b)=>a+b,0)])});doc.autoTable({head,body,startY:20});doc.save(`Result-${fp.cls}-${fp.sec}.pdf`);}
function downloadExcel(){let data=[['শ্রেণী: '+fp.cls+' শাখা: '+fp.sec],['ক্রম','নাম','রোল',...subs,'মোট'],['','পূর্ণমান','',...full,full.reduce((a,b)=>a+b,0)]];studs.forEach((st,i)=>{data.push([i+1,st.name,st.roll,...st.m,st.m.reduce((a,b)=>a+b,0)])});let ws=XLSX.utils.aoa_to_sheet(data);let wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'Result');XLSX.writeFile(wb,`Result-${fp.cls}-${fp.sec}.xlsx`);}
render();
</script>
</body>
</html>
